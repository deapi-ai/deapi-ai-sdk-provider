{
  "name": "@deapi/ai-sdk-provider",
  "version": "0.1.0",
  "description": "Vercel AI SDK provider for deAPI (image generation + embeddings) — OpenAI-compatible inference for open-source models.",
  "keywords": [
    "ai-sdk",
    "vercel-ai",
    "deapi",
    "image-generation",
    "embeddings",
    "openai-compatible"
  ],
  "author": "deAPI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deapi-ai/deapi-ai-sdk-provider.git"
  },
  "homepage": "https://github.com/deapi-ai/deapi-ai-sdk-provider#readme",
  "bugs": {
    "url": "https://github.com/deapi-ai/deapi-ai-sdk-provider/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "pack:audit": "node scripts/pack-audit.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run pack:audit && node scripts/consumer-smoke.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "ai": ">=6 <7"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.49",
    "@ai-sdk/provider": "^3.0.10",
    "@ai-sdk/provider-utils": "^4.0.28",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "ai": "^6.0.202",
    "eslint": "^10.4.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
